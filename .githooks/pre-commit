#!/usr/bin/env python3
"""Pre-commit hook: block sensitive content before it reaches the repo.

Mirrors .github/workflows/privacy-scan.yml but runs on staged files only
(git diff --cached) rather than all tracked files. Zero external deps."""

from pathlib import Path
import re
import subprocess
import sys

repo_root = Path(__file__).resolve().parents[1]

staged = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
    cwd=repo_root,
    text=True,
).splitlines()

if not staged:
    sys.exit(0)

blocked_paths = [
    re.compile(r"(^|/)_private(/|$)"),
    re.compile(r"(^|/)_drafts(/|$)"),
    re.compile(r"(^|/)_transcripts(/|$)"),
    re.compile(r"(^|/)docs/operating-model\.md$"),
    re.compile(r"(^|/)docs/plans(/|$)"),
    re.compile(r"(^|/)docs/workflows/research-to-practical-output\.md$"),
    re.compile(r"(^|/)PRODUCT\.md$"),
    re.compile(r"(^|/)INSPIRATION_REPORT\.md$"),
    re.compile(r"(^|/)\.drafts-private(/|$)"),
    re.compile(r"(^|/)screenshots?(/|$)"),
    re.compile(r"(^|/)transcripts?(/|$)"),
    re.compile(r"(^|/)recordings(/|$)"),
    re.compile(r"(^|/)exports?(/|$)"),
    re.compile(r"(^|/)downloads?(/|$)"),
    re.compile(r"(^|/)_data/today\.ya?ml$"),
    re.compile(r"(^|/)_posts/\d{4}-\d{2}-\d{2}-daily-learning\.md$"),
    re.compile(r"(?i)(private|secret|credential|token|client" "_secret|\.env|\.key|\.pem|\.p12|\.pfx|\.db|\.sqlite|\.csv|\.xlsx|\.numbers)$"),
    re.compile(r"(?i)(daily-post|milestone-post)\.ya?ml$"),
]

sensitive_text = re.compile(
    r"(?i)(api[_-]?key|client[_-]?secret|password|passwd|bearer\s+[A-Za-z0-9._\-]{12,}|"
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----|"
    r"לא לפרסום|סודי|פרטי פנימי|"
    r"pri" "vate" " " "internal)"
)

allow_files = {
    ".gitignore",
    "PUBLICATION_POLICY.md",
    ".github/pull_request_template.md",
    ".github/workflows/privacy-scan.yml",
    ".githooks/pre-commit",
    "privacy-policy.md",
    "terms-of-service.md",
    "boundaries.md",
    "_config.yml",
}

findings = []

for file_name in staged:
    # check blocked paths
    for pattern in blocked_paths:
        if pattern.search(file_name):
            findings.append(f"blocked path: {file_name}")
            break

    if file_name in allow_files:
        continue

    # read staged content via git show
    try:
        blob = subprocess.check_output(
            ["git", "show", f":{file_name}"],
            cwd=repo_root,
            text=True,
        )
    except subprocess.CalledProcessError:
        # deleted or submodule, skip
        continue

    if len(blob) > 500_000:
        continue

    for line_number, line in enumerate(blob.splitlines(), 1):
        if sensitive_text.search(line):
            findings.append(f"sensitive text: {file_name}:{line_number}: {line[:160]}")
            break

if findings:
    print("\n⚠️  Pre-commit privacy scan FAILED:\n")
    for finding in findings:
        print(f"  • {finding}")
    print()
    sys.exit(1)

print("✓ Privacy scan passed")
